MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=foodintel_db
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads
MODEL_PATH=ml/models/food_model_extensive.pt
CLASS_NAMES_PATH=ml/classes.json
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=10
PREDICTION_CONFIDENCE_THRESHOLD=0.55
PREDICTION_MARGIN_THRESHOLD=0.12
RETRAIN_ON_FEEDBACK=false
RETRAIN_BASE_DATASET_DIR=ml/dataset_master
RETRAIN_WORKING_DATASET_DIR=ml/dataset_live
RETRAIN_FEEDBACK_EXPORT_DIR=ml/dataset_feedback_live
RETRAIN_DEVICE=cpu
ADMIN_SECRET=replace-with-a-long-random-admin-secret

# Optional production upload storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
