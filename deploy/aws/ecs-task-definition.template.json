{
  "family": "foodintel-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "foodintel-api",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/foodintel-api:<IMAGE_TAG>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "MONGODB_DB_NAME", "value": "foodintel_db" },
        { "name": "UPLOAD_DIR", "value": "uploads" },
        { "name": "MODEL_PATH", "value": "ml/models/food_model_extensive.pt" },
        { "name": "CLASS_NAMES_PATH", "value": "ml/classes.json" },
        { "name": "RETRAIN_ON_FEEDBACK", "value": "false" },
        { "name": "MAX_UPLOAD_SIZE_MB", "value": "10" },
        { "name": "PREDICTION_CONFIDENCE_THRESHOLD", "value": "0.55" },
        { "name": "PREDICTION_MARGIN_THRESHOLD", "value": "0.12" },
        { "name": "CORS_ORIGINS", "value": "https://your-frontend-domain.com" }
      ],
      "secrets": [
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/foodintel/prod/MONGODB_URI"
        },
        {
          "name": "JWT_SECRET_KEY",
          "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/foodintel/prod/JWT_SECRET_KEY"
        },
        {
          "name": "CLOUDINARY_CLOUD_NAME",
          "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/foodintel/prod/CLOUDINARY_CLOUD_NAME"
        },
        {
          "name": "CLOUDINARY_API_KEY",
          "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/foodintel/prod/CLOUDINARY_API_KEY"
        },
        {
          "name": "CLOUDINARY_API_SECRET",
          "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/foodintel/prod/CLOUDINARY_API_SECRET"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5)\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/foodintel-api",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
