[Unit]
Description=FoodIntel Backend API
After=network.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/foodintel-backend
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/home/ec2-user/foodintel-backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
